  },

  "engines": {
    "node": ">=24"
  },

  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11"
    }
  },

  "workspaces": [
    "apps/*",
    "agents/*"
  ],

  "overrides": {
    "eslint": "^10",

    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    },

    "@vercel/cli-config": {
      "zod": "^4.6.6"
    }
  }
}
