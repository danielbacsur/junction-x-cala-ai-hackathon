{
  "name": "fundraising",
  "version": "0.0.0",
  "private": true,

  "scripts": {
    "build": "turbo run build",
    "deploy": "turbo run deploy",
    "dev": "turbo run dev",
    "eval": "turbo run eval",
    "lint": "turbo run lint",
    "start": "turbo run start",
    "typecheck": "turbo run typecheck"
  },

  "dependencies": {
    "@fundraising/package-vercel": "0.0.0"
  },

  "devDependencies": {
    "@types/node": "^24",
    "turbo": "^2",
    "typescript": "^5"
  },

  "engines": {
    "node": ">=24"
  },

  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11"
    }
  },

  "workspaces": [
    "apps/*",
    "agents/*",
    "packages/*"
  ],

  "overrides": {
    "eslint": "^10",

    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    },

    "@vercel/cli-config": {
      "zod": "^4.6.6"
    }
  }
}
