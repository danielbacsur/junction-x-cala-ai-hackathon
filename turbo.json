{
  "$schema": "https://turborepo.dev/schema.json",

  "ui": "tui",

  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", ".output/**"]
    },

    "deploy": {
      "cache": false
    },

    "dev": {
      "cache": false,
      "persistent": true,
      "interactive": true
    },

    "eval": {
      "dependsOn": ["^build"],
      "cache": false
    },

    "lint": {
      "dependsOn": ["^lint"]
    },

    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },

    "test": {
      "dependsOn": ["^build"]
    },

    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
